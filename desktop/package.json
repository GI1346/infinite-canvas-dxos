{
  "name": "infinite-canvas-dxos",
  "productName": "BlinkFlow",
  "version": "0.20.14",
  "description": "无限画布、多维表格、并发生成和中转站自定义协议",
  "author": "GI1346",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64"
  },
  "devDependencies": { "electron": "^40.0.0", "electron-builder": "^26.0.0" },
  "build": {
    "appId": "com.gi1346.infinitecanvasdxos",
    "directories": { "output": "release" },
    "files": ["*.cjs", "web/**/*", "assets/**/*", "package.json"],
    "extraResources": [{ "from": "../LICENSE", "to": "LICENSE.infinite-canvas" }],
    "win": { "target": "nsis", "signExecutable": false, "icon": "assets/blinkflow.ico", "artifactName": "BlinkFlow-Setup-${version}-${arch}.${ext}" },
    "nsis": { "include": "installer.nsh", "installerIcon": "assets/blinkflow.ico", "uninstallerIcon": "assets/blinkflow.ico", "installerHeaderIcon": "assets/blinkflow.ico", "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false }
  }
}
